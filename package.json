{
  "name": "watch-home",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Private Firefox watch-party synchronization extension and Cloudflare Worker.",
  "scripts": {
    "configure": "node scripts/configure.mjs",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "lint:addon": "web-ext lint --source-dir extension --self-hosted",
    "build:addon": "web-ext build --source-dir extension --artifacts-dir artifacts --overwrite-dest",
    "test": "node --test tests/*.test.mjs",
    "check:compliance": "node scripts/compliance-check.mjs",
    "audit:runtime": "npm audit --omit=dev",
    "check:all": "npm test && npm run lint:addon && npm run check:compliance && npm run audit:runtime",
    "verify:release": "node scripts/verify-release.mjs",
    "version:set": "node scripts/set-version.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "web-ext": "10.6.0",
    "wrangler": "4.131.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260911.1": true
  }
}
